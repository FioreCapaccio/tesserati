{
  "name": "tesserati",
  "productName": "Tesserati",
  "version": "1.0.0",
  "description": "Gestione tesserati, ricevute e scadenze per associazione culturale teatrale",
  "author": "Fioravante Capaccio",
  "license": "UNLICENSED",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/core.test.js",
    "dist:mac": "electron-builder --mac --arm64",
    "dist:win": "electron-builder --win --x64",
    "dist": "npm run dist:mac && npm run dist:win"
  },
  "build": {
    "appId": "it.associazione.tesserati",
    "productName": "Tesserati",
    "copyright": "Copyright © 2026 Fioravante Capaccio",
    "files": [
      "main.js",
      "preload.js",
      "core/**",
      "src/**",
      "build/icon.png",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "identity": null
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3"
  }
}
